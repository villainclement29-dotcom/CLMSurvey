{
  "appId": "com.clementvillain.veillescientifique",
  "appName": "Veille",
  "webDir": "www",
  "server": {
    "url": "https://clmsurvey.vercel.app",
    "cleartext": false,
    "allowNavigation": ["*"]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0f1115"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0f1115",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
